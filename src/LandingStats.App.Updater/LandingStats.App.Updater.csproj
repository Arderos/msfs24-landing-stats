<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>MSFS-Landing-Stats.Updater</AssemblyName>
    <RootNamespace>LandingStats.App.Updater</RootNamespace>
    <InformationalVersion>0.7.7-secure-updater</InformationalVersion>
    <ApplicationIcon>..\LandingStats.App\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LandingStats.App.RegressionTests" />
    <Compile Include="..\LandingStats.UpdateProtocol\UpdateProtocol.cs" Link="UpdateProtocol.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
