<Window x:Class="LandingStats.App.TelemetryUpload.TelemetryEnrollmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enable telemetry upload" Width="470" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#15181D" Foreground="#E8EDF2" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="ONE-TIME ENROLLMENT" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#AEB8C2"
                   Text="Enter the invitation code supplied by the maintainer. It registers this installation's public key; the private key never leaves this Windows account." />
        <TextBox x:Name="InviteCodeText" Grid.Row="2" Margin="0,18,0,0" Height="34" Padding="9,6"
                 FontFamily="Cascadia Mono, Consolas" FontSize="13" MaxLength="160" />
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,8,0,0" Foreground="#FF8A6A" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="92" Height="32" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button Width="110" Height="32" Content="Enroll" IsDefault="True" Click="OnEnrollClick" />
        </StackPanel>
    </Grid>
</Window>
