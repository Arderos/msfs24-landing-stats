<Window x:Class="LandingStats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LandingStats.App.Controls"
        Title="{DynamicResource Product.Name}"
        Width="1680"
        Height="940"
        MinWidth="1180"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/AppIcon.ico"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="InfoIconStyle" TargetType="{x:Type ContentControl}">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <Border x:Name="InfoRing" Width="15" Height="15"
                                Background="Transparent"
                                BorderBrush="{StaticResource MutedTextBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="InfoGlyph" Text="i"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InfoRing" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="InfoGlyph" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoToolTipTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="MaxWidth" Value="390" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style x:Key="SettingsChoiceStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#34302D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryDeleteButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#5A241A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFD8CF" />
            <Setter Property="Background" Value="#4A1812" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#672219" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#7A281C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="11" />
            <Setter Property="MinWidth" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Rail"
                                    Width="1"
                                    Margin="0,5"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BorderBrush}" />
                            <Track x:Name="PART_Track"
                                   Margin="0,5"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Cursor="SizeNS">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="Grip"
                                                            Width="2"
                                                            HorizontalAlignment="Center"
                                                            Background="{StaticResource AccentBrush}"
                                                            CornerRadius="1" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Width" Value="4" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Grip" Property="Width" Value="4" />
                                                        <Setter TargetName="Grip" Property="Background" Value="#FF956D" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="#3A3531" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="19*" MinWidth="272" MaxWidth="400" />
            <ColumnDefinition Width="81*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="Transparent"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.ico" Width="18" Height="18" SnapsToDevicePixels="True" />
                    <TextBlock Text="{DynamicResource Product.Name}" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="16" Background="#262321" Margin="14,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionStatusDot" Width="6" Height="6" Fill="{StaticResource AmberBrush}" />
                    <TextBlock x:Name="ConnectionStatusText" Text="{DynamicResource Top.Waiting}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="7,0,0,0" />
                    <TextBlock Text="·" Foreground="{StaticResource LabelTextBrush}" Margin="9,0" />
                    <TextBlock x:Name="RecorderModeText" Text="{DynamicResource Top.Offline}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Width="34" Height="28" Style="{StaticResource TopBarButtonStyle}" Click="OnSettingsClick"
                            ToolTip="{DynamicResource Top.Settings}" AutomationProperties.Name="{DynamicResource Top.Settings}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Content="—" Width="34" Height="28" Style="{StaticResource TopBarButtonStyle}" Click="OnMinimizeClick"
                            ToolTip="{DynamicResource Top.Minimize}" AutomationProperties.Name="{DynamicResource Top.Minimize}" />
                    <Button Content="□" Width="34" Height="28" Style="{StaticResource TopBarButtonStyle}" Click="OnMaximizeClick" FontSize="10"
                            ToolTip="{DynamicResource Top.Maximize}" AutomationProperties.Name="{DynamicResource Top.Maximize}" />
                    <Button Content="×" Width="34" Height="28" Style="{StaticResource TopBarButtonStyle}" Click="OnCloseClick" FontSize="13"
                            ToolTip="{DynamicResource Top.Close}" AutomationProperties.Name="{DynamicResource Top.Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,0">
                    <TextBlock Text="{DynamicResource History.Title}" Style="{StaticResource SectionLabelStyle}" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HistoryCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                </Grid>
                <Border Grid.Row="1" Height="30" Margin="12,0,12,12" Background="{StaticResource SurfaceBrush}" CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="1.3" />
                        <TextBox x:Name="SessionFilterBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 CaretBrush="{StaticResource TextBrush}"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,8,0"
                                 TextChanged="OnSessionFilterChanged"
                                 ToolTip="{DynamicResource History.Filter}" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource History.Filter}"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="1,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SessionFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <ListBox x:Name="LandingHistoryList" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnHistorySelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HistoryScrollBarStyle}" />
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Height" Value="58" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="14,0,16,0">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AircraftTitle}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding LocationDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding TimestampDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding InertialDisplay}" FontFamily="Cascadia Mono, Consolas" FontSize="14" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding G150Display, StringFormat={}{0} G}" Foreground="{StaticResource SubtleTextBrush}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource HistoryDeleteButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Tag="{Binding}"
                                        Click="OnDeleteLandingClick"
                                        ToolTip="{DynamicResource History.Delete}"
                                        AutomationProperties.Name="{DynamicResource History.Delete}">
                                    <Viewbox Width="15" Height="15">
                                        <Path Data="M 4,5 L 16,5 M 7,5 L 7,3 L 13,3 L 13,5 M 6,5 L 7,17 L 13,17 L 14,5 M 9,8 L 9,14 M 11,8 L 11,14"
                                              Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource History.AverageRate}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                    <TextBlock x:Name="AverageRateText" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid x:Name="LandingContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="50*" MaxHeight="560" />
                    <RowDefinition Height="8*" MinHeight="62" MaxHeight="100" />
                    <RowDefinition Height="8*" MinHeight="62" MaxHeight="100" />
                    <RowDefinition Height="8*" MinHeight="62" MaxHeight="100" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,18,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{Binding LocationDisplay}" FontSize="19" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding AircraftTitle}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding TimestampDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding WeightDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding CgDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding WindDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ContactDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="ChartWindowButton" Grid.Column="1" Height="28" Padding="11,0"
                            Content="{DynamicResource View.ContactFormat}" Style="{StaticResource OutlineButtonStyle}"
                            Click="OnChartWindowClick" VerticalAlignment="Top" FontSize="12" />
                </Grid>

                <Grid Grid.Row="1" Margin="24,18,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="45" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="45" />
                        <ColumnDefinition Width="0.93*" />
                        <ColumnDefinition Width="0.93*" />
                        <ColumnDefinition Width="1.20*" />
                        <ColumnDefinition Width="0.94*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Metric.AircraftRate}" Style="{StaticResource SectionLabelStyle}" Foreground="{StaticResource LabelTextBrush}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        AutomationProperties.Name="{DynamicResource Metric.AircraftRate}"
                                        AutomationProperties.HelpText="{DynamicResource Help.AircraftRate}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.AircraftRate}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0">
                        <TextBlock Text="{Binding InertialDisplay}" FontSize="44" FontWeight="SemiBold" />
                        <TextBlock Text="fpm" Foreground="{StaticResource MutedTextBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,8" />
                        <TextBlock Text="{Binding LandingFeelDisplay}" FontSize="9" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" Margin="8,0,0,9">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFirmLanding}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        Margin="4,0,0,8"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="{DynamicResource Help.LandingFeelName}"
                                        AutomationProperties.HelpText="{Binding LandingFeelTooltip}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{Binding LandingFeelTooltip}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <TextBlock Grid.Column="0" Grid.Row="2" Text="{DynamicResource Metric.AircraftRateSubline}" Style="{StaticResource MetricSublineStyle}" />

                    <Border Grid.Column="1" Grid.RowSpan="3" Width="1" HorizontalAlignment="Center" Background="{StaticResource BorderBrush}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Metric.SurfaceClosure}" Style="{StaticResource SectionLabelStyle}"
                                   Foreground="{StaticResource LabelTextBrush}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        AutomationProperties.Name="{DynamicResource Metric.SurfaceClosure}"
                                        AutomationProperties.HelpText="{DynamicResource Help.SurfaceClosure}">
                            <ContentControl.ToolTip>
                                <StackPanel MaxWidth="390">
                                    <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                               Text="{DynamicResource Help.SurfaceClosure}" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="10" Text="{Binding SurfaceQualityDisplay}" />
                                </StackPanel>
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0">
                        <TextBlock Text="{Binding SurfaceValueDisplay}" FontSize="44" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SurfaceUnitDisplay}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,8" />
                        <TextBlock Text="{Binding DeltaDisplay, StringFormat={}  Δ {0}}" Foreground="{StaticResource BlueBrush}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Bottom" Margin="7,0,0,8" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        Margin="4,0,0,7"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="{DynamicResource Metric.SurfaceDelta}"
                                        AutomationProperties.HelpText="{DynamicResource Help.SurfaceDelta}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.SurfaceDelta}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TerrainMetricDisplay}" Style="{StaticResource MetricSublineStyle}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="{DynamicResource Metric.Terrain}"
                                        AutomationProperties.HelpText="{DynamicResource Help.Terrain}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.Terrain}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                        <TextBlock Text="  ·  " Style="{StaticResource MetricSublineStyle}" />
                        <TextBlock Text="{Binding UnresolvedMetricDisplay}" Style="{StaticResource MetricSublineStyle}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="{DynamicResource Metric.Unresolved}"
                                        AutomationProperties.HelpText="{DynamicResource Help.Unresolved}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.Unresolved}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>

                    <Border Grid.Column="3" Grid.RowSpan="3" Width="1" HorizontalAlignment="Center" Background="{StaticResource BorderBrush}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Metric.PeakG150}" Style="{StaticResource SectionLabelStyle}" Foreground="{StaticResource LabelTextBrush}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        AutomationProperties.Name="{DynamicResource Metric.PeakG150}"
                                        AutomationProperties.HelpText="{DynamicResource Help.PeakG150}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.PeakG150}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding G150Display}" FontSize="22" FontWeight="Medium" VerticalAlignment="Center" Margin="0,7,0,0" />
                    <StackPanel Grid.Column="4" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding G2SecondsDisplay}" Style="{StaticResource MetricSublineStyle}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="{DynamicResource Metric.PeakG2}"
                                        AutomationProperties.HelpText="{DynamicResource Help.PeakG2}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.PeakG2}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock Text="{DynamicResource Metric.Ias}" Style="{StaticResource SectionLabelStyle}" Foreground="{StaticResource LabelTextBrush}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        AutomationProperties.Name="{DynamicResource Metric.Ias}"
                                        AutomationProperties.HelpText="{DynamicResource Help.Ias}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.Ias}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <TextBlock Grid.Column="5" Grid.Row="1" Text="{Binding AirspeedDisplay}" FontSize="22" FontWeight="Medium" VerticalAlignment="Center" Margin="22,7,0,0" />
                    <TextBlock Grid.Column="5" Grid.Row="2" Text="{DynamicResource Metric.Indicated}" Style="{StaticResource MetricSublineStyle}" Margin="22,7,0,0" />

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock Text="{DynamicResource Metric.PitchBank}" Style="{StaticResource SectionLabelStyle}" Foreground="{StaticResource LabelTextBrush}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        AutomationProperties.Name="{DynamicResource Metric.PitchBank}"
                                        AutomationProperties.HelpText="{DynamicResource Help.PitchBank}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.PitchBank}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <TextBlock Grid.Column="6" Grid.Row="1" Text="{Binding AttitudeDisplay}" FontSize="18" FontWeight="Medium" VerticalAlignment="Center" Margin="22,7,0,0" />
                    <StackPanel Grid.Column="6" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,7,0,0">
                        <TextBlock Text="{Binding AngleOfAttackDisplay}" Style="{StaticResource MetricSublineStyle}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="{DynamicResource Chart.Aoa}"
                                        AutomationProperties.HelpText="{DynamicResource Help.Aoa}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.Aoa}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>

                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock Text="{DynamicResource Metric.GroundSpeed}" Style="{StaticResource SectionLabelStyle}" Foreground="{StaticResource LabelTextBrush}" />
                        <ContentControl Style="{StaticResource InfoIconStyle}"
                                        AutomationProperties.Name="{DynamicResource Metric.GroundSpeed}"
                                        AutomationProperties.HelpText="{DynamicResource Help.GroundSpeed}">
                            <ContentControl.ToolTip>
                                <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                           Text="{DynamicResource Help.GroundSpeed}" />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <TextBlock Grid.Column="7" Grid.Row="1" Text="{Binding GroundSpeedDisplay}" FontSize="22" FontWeight="Medium" VerticalAlignment="Center" Margin="22,7,0,0" />
                    <TextBlock Grid.Column="7" Grid.Row="2" Text="{DynamicResource Metric.AtContact}" Style="{StaticResource MetricSublineStyle}" Margin="22,7,0,0" />
                </Grid>

                <Border x:Name="ClosureReconstructionPanel"
                        Grid.Row="2"
                        Margin="24,0,24,18"
                        Padding="14,10"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Recon.Title}"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Foreground="{StaticResource LabelTextBrush}"
                                           VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource InfoIconStyle}"
                                                AutomationProperties.Name="{DynamicResource Recon.Title}"
                                                AutomationProperties.HelpText="{DynamicResource Recon.Help}">
                                    <ContentControl.ToolTip>
                                        <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                                   Text="{DynamicResource Recon.Help}" />
                                    </ContentControl.ToolTip>
                                </ContentControl>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ClosureModelDisplay}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <ContentControl Grid.Column="2"
                                            Style="{StaticResource InfoIconStyle}"
                                            AutomationProperties.Name="{DynamicResource Recon.Model}"
                                            AutomationProperties.HelpText="{DynamicResource Recon.ModelHelp}">
                                <ContentControl.ToolTip>
                                    <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                               Text="{DynamicResource Recon.ModelHelp}" />
                                </ContentControl.ToolTip>
                            </ContentControl>
                        </Grid>

                        <Grid Grid.Row="1"
                              Visibility="{Binding HasClosureReconstruction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="2.15*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.85*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Recon.ModeledClosure}" Style="{StaticResource SectionLabelStyle}"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <ContentControl Style="{StaticResource InfoIconStyle}"
                                                    AutomationProperties.Name="{DynamicResource Recon.ModeledClosure}"
                                                    AutomationProperties.HelpText="{DynamicResource Recon.ModeledClosureHelp}">
                                        <ContentControl.ToolTip>
                                            <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                                       Text="{DynamicResource Recon.ModeledClosureHelp}" />
                                        </ContentControl.ToolTip>
                                    </ContentControl>
                                </StackPanel>
                                <TextBlock Text="{Binding ClosureModeledDisplay}" Margin="0,3,0,0"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="Medium" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Recon.RawMinusModel}" Style="{StaticResource SectionLabelStyle}"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <ContentControl Style="{StaticResource InfoIconStyle}"
                                                    AutomationProperties.Name="{DynamicResource Recon.RawMinusModel}"
                                                    AutomationProperties.HelpText="{DynamicResource Recon.RawMinusModelHelp}">
                                        <ContentControl.ToolTip>
                                            <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                                       Text="{DynamicResource Recon.RawMinusModelHelp}" />
                                        </ContentControl.ToolTip>
                                    </ContentControl>
                                </StackPanel>
                                <TextBlock Text="{Binding ClosureResidualDisplay}" Margin="0,3,0,0"
                                           Foreground="{StaticResource BlueBrush}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="Medium" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Recon.Components}" Style="{StaticResource SectionLabelStyle}"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <ContentControl Style="{StaticResource InfoIconStyle}"
                                                    AutomationProperties.Name="{DynamicResource Recon.Components}"
                                                    AutomationProperties.HelpText="{DynamicResource Recon.ComponentsHelp}">
                                        <ContentControl.ToolTip>
                                            <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                                       Text="{DynamicResource Recon.ComponentsHelp}" />
                                        </ContentControl.ToolTip>
                                    </ContentControl>
                                </StackPanel>
                                <TextBlock Text="{Binding ClosureComponentsDisplay}" Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Recon.Uncertainty}" Style="{StaticResource SectionLabelStyle}"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <ContentControl Style="{StaticResource InfoIconStyle}"
                                                    AutomationProperties.Name="{DynamicResource Recon.Uncertainty}"
                                                    AutomationProperties.HelpText="{DynamicResource Recon.UncertaintyHelp}">
                                        <ContentControl.ToolTip>
                                            <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                                       Text="{DynamicResource Recon.UncertaintyHelp}" />
                                        </ContentControl.ToolTip>
                                    </ContentControl>
                                </StackPanel>
                                <TextBlock Text="{Binding ClosureUncertaintyDisplay}" Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Recon.Geometry}" Style="{StaticResource SectionLabelStyle}"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <ContentControl Style="{StaticResource InfoIconStyle}"
                                                    AutomationProperties.Name="{DynamicResource Recon.Geometry}"
                                                    AutomationProperties.HelpText="{DynamicResource Recon.GeometryHelp}">
                                        <ContentControl.ToolTip>
                                            <TextBlock Style="{StaticResource InfoToolTipTextStyle}"
                                                       Text="{DynamicResource Recon.GeometryHelp}" />
                                        </ContentControl.ToolTip>
                                    </ContentControl>
                                </StackPanel>
                                <TextBlock Text="{Binding ClosureGeometryDisplay}" Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" MinHeight="41">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasClosureReconstruction}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Recon.UnavailableTitle}"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{DynamicResource Recon.UnavailableBody}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="24,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton x:Name="VerticalRateTab" Content="{DynamicResource Chart.TabVerticalRate}" Tag="VerticalSpeed" GroupName="ChartMode" Style="{StaticResource ChartTabStyle}" Checked="OnChartModeChanged" />
                        <RadioButton Content="{DynamicResource Chart.TabLoads}" Tag="LoadFactors" GroupName="ChartMode" Style="{StaticResource ChartTabStyle}" Checked="OnChartModeChanged" />
                        <RadioButton Content="{DynamicResource Chart.TabControls}" Tag="FlightControls" GroupName="ChartMode" Style="{StaticResource ChartTabStyle}" Checked="OnChartModeChanged" />
                        <RadioButton Content="{DynamicResource Chart.TabAttitude}" Tag="Attitude" GroupName="ChartMode" Style="{StaticResource ChartTabStyle}" Checked="OnChartModeChanged" />
                        <RadioButton Content="{DynamicResource Chart.TabPower}" Tag="Power" GroupName="ChartMode" Style="{StaticResource ChartTabStyle}" Checked="OnChartModeChanged" />
                        <RadioButton Content="{DynamicResource Chart.TabGear}" Tag="Gear" GroupName="ChartMode" Style="{StaticResource ChartTabStyle}" Checked="OnChartModeChanged" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="MainChartDescription" Text="{DynamicResource Chart.DescriptionVertical}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                    <Border x:Name="MainLegendSeparator" Grid.Column="3" Width="1" Height="12" Background="#262321" Margin="22,0,22,10" VerticalAlignment="Bottom" />
                    <StackPanel x:Name="MainLegendPanel" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" />
                    <Border Grid.ColumnSpan="5" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Bottom" Panel.ZIndex="-1" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,12,24,6">
                    <controls:LandingChart x:Name="MainChart" Mode="VerticalSpeed" ShowLegend="False" ShowXAxisLabels="False" />
                    <TextBlock x:Name="ModeUnitText" Text="fpm" Foreground="{StaticResource LabelTextBrush}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="10"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,8" />
                </Grid>

                <Border Grid.Row="5" BorderBrush="#1A1917" BorderThickness="0,1,0,0" Margin="0,0,24,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="24,9,0,0">
                            <TextBlock Text="{DynamicResource Chart.VerticalG}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="0,8,0,8">
                            <controls:LandingChart x:Name="MiniGChart" Mode="LoadFactors" ShowLegend="False" ShowHoverTooltip="True" ShowXAxisLabels="False" CompactLane="True" />
                            <TextBlock Text="0.8 – 1.6" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource LabelTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="9" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="6" BorderBrush="#1A1917" BorderThickness="0,1,0,0" Margin="0,0,24,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="24,9,0,0">
                            <TextBlock Text="N1" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="0,8,0,8">
                            <controls:LandingChart x:Name="MiniPowerChart" Mode="Power" ShowLegend="False" ShowHoverTooltip="True" ShowXAxisLabels="False" CompactLane="True" PowerShowThrottle="False" />
                            <TextBlock Text="0 – 100%" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource LabelTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="9" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="7" BorderBrush="#1A1917" BorderThickness="0,1,0,0" Margin="0,0,24,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="24,9,0,0">
                            <TextBlock Text="{DynamicResource Chart.MainGear}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="0,8,0,8">
                            <controls:LandingChart x:Name="MiniGearChart" Mode="Gear" ShowLegend="False" ShowHoverTooltip="True" ShowXAxisLabels="False" CompactLane="True" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,24,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HoverTimeText" Text="0.00s" Margin="24,0,0,0" VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                        <controls:LandingTimeline x:Name="Timeline" Grid.Column="1" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="EmptyState" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                    <Border Width="15" Height="15" Background="{StaticResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateTitle" Text="{DynamicResource History.NoLandingsTitle}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock x:Name="EmptyStateDescription" Text="{DynamicResource History.NoLandingsBody}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Footer.Window}" Foreground="{StaticResource LabelTextBrush}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding RecordSummaryDisplay}" Foreground="{StaticResource LabelTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Grid.Column="2" x:Name="VersionAuthorText" Foreground="{StaticResource LabelTextBrush}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="10" VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="https://github.com/Arderos/msfs24-landing-stats/releases"
                               RequestNavigate="OnReleasesLinkNavigate" Foreground="{StaticResource LabelTextBrush}">
                        <Run x:Name="VersionAuthorRun" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Grid.Column="3" x:Name="UploadStatusText" Text="{DynamicResource Footer.ReportWaiting}"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="10" VerticalAlignment="Center"
                           Margin="0,0,10,0" MaxWidth="330" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button Grid.Column="4"
                        x:Name="ReportBugButton"
                        Content="{DynamicResource Footer.ReportBug}"
                        Style="{StaticResource OutlineButtonStyle}"
                        FontSize="10"
                        Height="26"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        Opacity="0.42"
                        Click="OnReportBugClick"
                        ToolTip="{DynamicResource Footer.ReportBugHelp}" />
                <TextBlock Grid.Column="5" x:Name="StoragePathText" Foreground="{StaticResource LabelTextBrush}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="310" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Border>

        <Grid x:Name="ReplayUnsupportedOverlay"
              Grid.RowSpan="3" Grid.ColumnSpan="2"
              Panel.ZIndex="120"
              Background="#B8000000"
              Visibility="Collapsed"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              MouseLeftButtonDown="OnReplayOverlayBackgroundClick"
              PreviewKeyDown="OnReplayOverlayKeyDown">
            <Border Width="430"
                    MaxWidth="430"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#3A3531"
                    BorderThickness="1"
                    CornerRadius="10"
                    MouseLeftButtonDown="OnReplayDialogClick">
                <StackPanel>
                    <Border Width="38" Height="38" HorizontalAlignment="Left"
                            Background="{StaticResource DangerSoftBrush}" CornerRadius="19">
                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Replay.Title}"
                               FontSize="18" FontWeight="SemiBold" Margin="0,17,0,0" />
                    <TextBlock Text="{DynamicResource Replay.Body}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,9,0,0" />
                    <Button x:Name="CloseReplayUnsupportedButton"
                            Content="{DynamicResource Common.Close}"
                            Height="34" HorizontalAlignment="Right" Margin="0,22,0,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="OnCloseReplayUnsupportedClick" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="3" Grid.ColumnSpan="2"
              Panel.ZIndex="110"
              Background="#B8000000"
              Visibility="Collapsed"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="OnSettingsOverlayKeyDown">
            <Border Width="520"
                    MaxWidth="520"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#3A3531"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="{StaticResource AccentSoftBrush}" CornerRadius="17">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Title}"
                                   FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="13,0,0,0" />
                        <Button Grid.Column="2" Content="×" Width="30" Height="30"
                                Style="{StaticResource TopBarButtonStyle}"
                                Click="OnCloseSettingsClick"
                                AutomationProperties.Name="{DynamicResource Top.Close}" />
                    </Grid>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="16" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Language}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource LabelTextBrush}" />
                            <TextBlock Text="{DynamicResource Settings.LanguageBody}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" LineHeight="17" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <RadioButton x:Name="SettingsLanguageAuto"
                                             Content="{DynamicResource Settings.Automatic}"
                                             Tag="auto" GroupName="ApplicationLanguage"
                                             Style="{StaticResource SettingsChoiceStyle}"
                                             Checked="OnLanguageSelectionChanged" />
                                <RadioButton x:Name="SettingsLanguageEnglish"
                                             Content="{DynamicResource Settings.English}"
                                             Tag="en" GroupName="ApplicationLanguage"
                                             Style="{StaticResource SettingsChoiceStyle}"
                                             Checked="OnLanguageSelectionChanged" />
                                <RadioButton x:Name="SettingsLanguageRussian"
                                             Content="{DynamicResource Settings.Russian}"
                                             Tag="ru" GroupName="ApplicationLanguage"
                                             Style="{StaticResource SettingsChoiceStyle}"
                                             Checked="OnLanguageSelectionChanged" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsAutomaticLanguageText"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="10" Margin="0,11,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SettingsErrorText"
                               Visibility="Collapsed"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock x:Name="SettingsFileText"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                    <Button x:Name="CloseSettingsButton"
                            Content="{DynamicResource Common.Done}"
                            Height="34" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="OnCloseSettingsClick" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DeleteLandingOverlay"
              Grid.RowSpan="3" Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="#B8000000"
              Visibility="Collapsed"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="OnDeleteLandingOverlayKeyDown">
            <Border Width="430"
                    MaxWidth="430"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#3A3531"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <Border Width="34" Height="34" HorizontalAlignment="Left"
                            Background="{StaticResource DangerSoftBrush}" CornerRadius="17">
                        <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 4,5 L 16,5 M 7,5 L 7,3 L 13,3 L 13,5 M 6,5 L 7,17 L 13,17 L 14,5 M 9,8 L 9,14 M 11,8 L 11,14"
                                  Fill="Transparent" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource Delete.Title}" FontSize="17" FontWeight="SemiBold" Margin="0,17,0,0" />
                    <TextBlock Text="{DynamicResource Delete.Body}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0" />
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7" Padding="12,10" Margin="0,16,0,0">
                        <TextBlock x:Name="DeleteLandingDescription"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                    </Border>
                    <TextBlock x:Name="DeleteLandingErrorText"
                               Visibility="Collapsed"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="CancelDeleteLandingButton"
                                Content="{DynamicResource Common.Cancel}"
                                Height="34"
                                Style="{StaticResource OutlineButtonStyle}"
                                Click="OnCancelDeleteLandingClick" />
                        <Button x:Name="ConfirmDeleteLandingButton"
                                Content="{DynamicResource Common.Delete}"
                                Height="34"
                                Margin="10,0,0,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="OnConfirmDeleteLandingClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
