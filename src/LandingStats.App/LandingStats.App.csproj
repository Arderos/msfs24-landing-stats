<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>MSFS-Landing-Stats</AssemblyName>
    <InformationalVersion>0.7.3-live</InformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <MsfsSdkRoot Condition="'$(MsfsSdkRoot)' == '' and '$(MSFS_SDK)' != ''">$(MSFS_SDK)</MsfsSdkRoot>
    <MsfsSdkRoot Condition="'$(MsfsSdkRoot)' == ''">D:\MSFS 2024 SDK</MsfsSdkRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LandingStats.App.RegressionTests" />
    <Compile Include="..\LandingStats.UpdateProtocol\UpdateProtocol.cs" Link="Updates\UpdateProtocol.cs" />
    <None Remove="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.ico" />
    <ProjectReference Include="..\LandingStats.Core\LandingStats.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(MsfsSdkRoot)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <None Include="$(MsfsSdkRoot)\SimConnect SDK\lib\SimConnect.dll">
      <Link>SimConnect.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateMsfsSdk" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(MsfsSdkRoot)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')"
      Text="MSFS 2024 SimConnect SDK not found under '$(MsfsSdkRoot)'. Set /p:MsfsSdkRoot=&quot;path to MSFS 2024 SDK&quot;." />
  </Target>
</Project>
