    <MSBuild Projects="../LandingStats.WorkerHost/LandingStats.WorkerHost.csproj" Targets="GetWorkerPayload" BuildInParallel="false" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="WorkerRuntime" />
    </MSBuild>
